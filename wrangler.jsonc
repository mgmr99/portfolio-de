{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "blog-api",
  "main": "./dist/worker/index.js",
  "compatibility_date": "2026-11-06",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "kv_namespaces": [
    {
      "binding": "BLOG_POSTS",
      "id": "BLOG_POSTS"
    }
  ]
}
